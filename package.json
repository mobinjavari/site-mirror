{
  "name": "site-mirror",
  "version": "1.0.0",
  "description": "Downloads and rebuilds a fully offline, locally-runnable copy of a given website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "mirror": "tsx cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "mime-types": "3.0.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
